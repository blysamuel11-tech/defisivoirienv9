# =============================================================================
#  Signature release Android — exemple (NE PAS COMMITER les vraies valeurs)
# =============================================================================
# Copiez ce fichier vers  android/keystore.properties  puis remplissez vos
# valeurs réelles. Ce chemin est déjà ignoré par git (voir android/.gitignore).
#
#   cp android/keystore.properties.example android/keystore.properties
#
# Le fichier keystore (.jks / .keystore) lui-même doit aussi rester hors du
# contrôle de version. Conservez une copie de sauvegarde précieuse : sans lui,
# vous ne pourrez JAMAIS mettre à jour l'application sur le Play Store.

# Chemin du keystore. Relatif au dossier android/app, ou chemin absolu.
# Exemple (keystore placé à la racine android/) :
#   storeFile=../gbe-moument-release.keystore
storeFile=../gbe-moument-release.keystore

# Mot de passe du keystore
storePassword=

# Alias de la clé de signature
keyAlias=gbe-moument

# Mot de passe de la clé
keyPassword=
